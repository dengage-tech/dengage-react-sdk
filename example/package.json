{
  "name": "@dengage-tech/react-native-dengage-example",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:logs": "react-native start --client-logs",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build": "cd ios && xcodebuild -workspace ReactNativeDengageExample.xcworkspace -scheme ReactNativeDengageExample -configuration Debug -sdk iphonesimulator",
    "clean": "cd ios && xcodebuild clean",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@dengage-tech/react-native-dengage": "file:..",
